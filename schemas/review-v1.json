{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": ["trade_ref", "classification", "verified_at"],
  "properties": {
    "trade_ref": {"type": "string", "minLength": 1},
    "classification": {
      "enum": ["success", "failure", "invalidated", "inconclusive"]
    },
    "verified_at": {"type": "string", "minLength": 1}
  }
}
