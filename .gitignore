# Screening caches
# Legacy raw JSON cache. Kept ignored for back-compat; new runs write to
# data/raw/screening/ which is git-tracked (issue #45).
.cache/

# SQLite caches and rebuild temp files derived from data/raw/. The
# data/raw/ tree itself is git-tracked as the canonical raw JSON source.
data/cache/

# Per-run lineage manifests are derived artifacts of a screening run; the
# screened YAML records cache_manifest_hash, so the manifest JSON itself
# does not need to be in git.
data/raw/screening/manifests/

# Local environment files
.env

# Local Codex workspace files
/.codex
