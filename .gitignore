.ruff_cache/
dist/

# Local planning drafts
.plan/

# Screening caches
# Local legacy raw JSON cache. New runs write to records/_data/raw/screening/,
# which is git-tracked.
.cache/

# SQLite caches and rebuild temp files derived from records/_data/raw/. The
# records/_data/raw/ tree itself is git-tracked as the canonical raw JSON source.
records/_data/cache/

# Per-run lineage manifests are derived artifacts of a screening run; the
# screened YAML records cache_manifest_hash, so the manifest JSON itself
# does not need to be in git.
records/_data/raw/screening/manifests/

# Local environment files
.env

# Local Codex workspace files
/.codex
