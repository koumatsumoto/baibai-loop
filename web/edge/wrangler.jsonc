{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "baibai-loop",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-21",
  "workers_dev": true,
  "preview_urls": false,
  // Query credentials must not enter persisted telemetry. This Wrangler version
  // cannot express redact_query_string; keep production observability disabled.
  "observability": { "enabled": false },
  "logpush": false,
  "r2_buckets": [
    {
      "binding": "BAIBAI_SERVING",
      "bucket_name": "baibai-serving"
    }
  ],
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*", "!/assets/*"]
  }
}
