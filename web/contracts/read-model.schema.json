{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Baibai Loop read model",
  "schemaVersion": 8,
  "roots": {
    "views/latest-proposal.json": "#/$defs/LatestProposalView",
    "views/outcomes.json": "#/$defs/OutcomesView",
    "views/portfolio-dashboard.json": "#/$defs/DashboardView",
    "views/tasks.json": "#/$defs/TasksView"
  },
  "$defs": {
    "DashboardView": {
      "properties": {
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "ledger_exists": {
          "title": "Ledger Exists",
          "type": "boolean"
        },
        "ledger_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ledger Error"
        },
        "ledger_as_of": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ledger As Of"
        },
        "valuation_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "市場評価の読取失敗。台帳事実は保持し、株価等の欠測だけの場合はnull。",
          "title": "Valuation Error"
        },
        "valuation_as_of": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Valuation As Of"
        },
        "total_capital_yen": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Total Capital Yen"
        },
        "available_cash_yen": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "台帳上の未予約現金。売却代金は約定時にgrossで計上し、受渡済み資金や証券会社の発注可能額は表さない。",
          "title": "Available Cash Yen"
        },
        "reserved_cash_yen": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reserved Cash Yen"
        },
        "holdings_market_value_yen": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Holdings Market Value Yen"
        },
        "deployed_cost_yen": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Deployed Cost Yen"
        },
        "realized_gross_pnl_yen": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Realized Gross Pnl Yen"
        },
        "cash_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cash Pct"
        },
        "reserved_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reserved Pct"
        },
        "deployed_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Deployed Pct"
        },
        "holdings": {
          "items": {
            "$ref": "#/$defs/HoldingView"
          },
          "title": "Holdings",
          "type": "array"
        },
        "reservations": {
          "items": {
            "$ref": "#/$defs/ReservationView"
          },
          "title": "Reservations",
          "type": "array"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/WarningView"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "generated_at",
        "ledger_exists",
        "ledger_error",
        "ledger_as_of",
        "valuation_error",
        "valuation_as_of",
        "total_capital_yen",
        "available_cash_yen",
        "reserved_cash_yen",
        "holdings_market_value_yen",
        "deployed_cost_yen",
        "realized_gross_pnl_yen",
        "cash_pct",
        "reserved_pct",
        "deployed_pct",
        "holdings",
        "reservations",
        "warnings"
      ],
      "title": "DashboardView",
      "type": "object"
    },
    "HoldingView": {
      "properties": {
        "ticker": {
          "title": "Ticker",
          "type": "string"
        },
        "company_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Company Name"
        },
        "sector": {
          "title": "Sector",
          "type": "string"
        },
        "quantity": {
          "title": "Quantity",
          "type": "integer"
        },
        "deployed_cost_yen": {
          "title": "Deployed Cost Yen",
          "type": "integer"
        },
        "market_price_yen": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Market Price Yen"
        },
        "market_price_as_of": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Market Price As Of"
        },
        "market_value_yen": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Market Value Yen"
        },
        "unrealized_pnl_yen": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unrealized Pnl Yen"
        },
        "unrealized_pnl_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unrealized Pnl Pct"
        }
      },
      "required": [
        "ticker",
        "company_name",
        "sector",
        "quantity",
        "deployed_cost_yen",
        "market_price_yen",
        "market_price_as_of",
        "market_value_yen",
        "unrealized_pnl_yen",
        "unrealized_pnl_pct"
      ],
      "title": "HoldingView",
      "type": "object"
    },
    "LatestProposalView": {
      "properties": {
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "status": {
          "enum": [
            "ready",
            "empty",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error"
        },
        "proposal": {
          "anyOf": [
            {
              "$ref": "#/$defs/SavedProposalView"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "generated_at",
        "status",
        "error",
        "proposal"
      ],
      "title": "LatestProposalView",
      "type": "object"
    },
    "OutcomesView": {
      "properties": {
        "outcomes": {
          "items": {
            "$ref": "#/$defs/PortfolioOutcomeView"
          },
          "title": "Outcomes",
          "type": "array"
        }
      },
      "required": [
        "outcomes"
      ],
      "title": "OutcomesView",
      "type": "object"
    },
    "PortfolioOutcomeView": {
      "properties": {
        "outcome_id": {
          "title": "Outcome Id",
          "type": "string"
        },
        "horizon": {
          "title": "Horizon",
          "type": "string"
        },
        "period_start_date": {
          "format": "date",
          "title": "Period Start Date",
          "type": "string"
        },
        "period_end_date": {
          "format": "date",
          "title": "Period End Date",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "portfolio_twr_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "記録済みの税・費用を反映した期間return。未報告の税・費用をゼロ確定とみなさない。",
          "title": "Portfolio Twr Pct"
        },
        "benchmark_cumulative_return_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Benchmark Cumulative Return Pct"
        }
      },
      "required": [
        "outcome_id",
        "horizon",
        "period_start_date",
        "period_end_date",
        "status",
        "reason",
        "portfolio_twr_pct",
        "benchmark_cumulative_return_pct"
      ],
      "title": "PortfolioOutcomeView",
      "type": "object"
    },
    "ReservationView": {
      "properties": {
        "reservation_id": {
          "title": "Reservation Id",
          "type": "string"
        },
        "side": {
          "enum": [
            "buy",
            "sell"
          ],
          "title": "Side",
          "type": "string"
        },
        "ticker": {
          "title": "Ticker",
          "type": "string"
        },
        "sector": {
          "title": "Sector",
          "type": "string"
        },
        "remaining_quantity": {
          "title": "Remaining Quantity",
          "type": "integer"
        },
        "price_guard_yen": {
          "title": "Price Guard Yen",
          "type": "string"
        },
        "reserved_yen": {
          "title": "Reserved Yen",
          "type": "integer"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expires At"
        },
        "expiry_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expiry Label"
        },
        "route_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Route Label"
        }
      },
      "required": [
        "reservation_id",
        "side",
        "ticker",
        "sector",
        "remaining_quantity",
        "price_guard_yen",
        "reserved_yen",
        "expires_at",
        "expiry_label",
        "route_label"
      ],
      "title": "ReservationView",
      "type": "object"
    },
    "SavedAssessmentReviewView": {
      "properties": {
        "reviewed_at": {
          "format": "date-time",
          "title": "Reviewed At",
          "type": "string"
        },
        "primary_source_check": {
          "enum": [
            "verified",
            "partially_verified",
            "unverified"
          ],
          "title": "Primary Source Check",
          "type": "string"
        },
        "review_scope": {
          "title": "Review Scope",
          "type": "string"
        },
        "strongest_countercase": {
          "title": "Strongest Countercase",
          "type": "string"
        },
        "uncertainty_acceptance_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Uncertainty Acceptance Reason"
        }
      },
      "required": [
        "reviewed_at",
        "primary_source_check",
        "review_scope",
        "strongest_countercase",
        "uncertainty_acceptance_reason"
      ],
      "title": "SavedAssessmentReviewView",
      "type": "object"
    },
    "SavedAssessmentView": {
      "properties": {
        "assessment_id": {
          "title": "Assessment Id",
          "type": "string"
        },
        "core_sha256": {
          "title": "Core Sha256",
          "type": "string"
        },
        "review_id": {
          "title": "Review Id",
          "type": "string"
        },
        "as_of": {
          "format": "date",
          "title": "As Of",
          "type": "string"
        },
        "stance": {
          "enum": [
            "supported",
            "uncertain",
            "unsupported"
          ],
          "title": "Stance",
          "type": "string"
        },
        "investment_case_explanation": {
          "title": "Investment Case Explanation",
          "type": "string"
        },
        "investment_case_status": {
          "enum": [
            "intact",
            "broken",
            "uncertain"
          ],
          "title": "Investment Case Status",
          "type": "string"
        },
        "investment_case_status_reason": {
          "title": "Investment Case Status Reason",
          "type": "string"
        },
        "invalidation_conditions": {
          "items": {
            "type": "string"
          },
          "title": "Invalidation Conditions",
          "type": "array"
        },
        "review": {
          "$ref": "#/$defs/SavedAssessmentReviewView"
        }
      },
      "required": [
        "assessment_id",
        "core_sha256",
        "review_id",
        "as_of",
        "stance",
        "investment_case_explanation",
        "investment_case_status",
        "investment_case_status_reason",
        "invalidation_conditions",
        "review"
      ],
      "title": "SavedAssessmentView",
      "type": "object"
    },
    "SavedBuyItemView": {
      "properties": {
        "ticker": {
          "title": "Ticker",
          "type": "string"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "review_conditions": {
          "items": {
            "type": "string"
          },
          "title": "Review Conditions",
          "type": "array"
        },
        "assessment": {
          "anyOf": [
            {
              "$ref": "#/$defs/SavedAssessmentView"
            },
            {
              "type": "null"
            }
          ]
        },
        "saved_quote": {
          "anyOf": [
            {
              "$ref": "#/$defs/SavedQuoteView"
            },
            {
              "type": "null"
            }
          ]
        },
        "liquidity": {
          "anyOf": [
            {
              "$ref": "#/$defs/SavedLiquidityView"
            },
            {
              "type": "null"
            }
          ]
        },
        "unfinished": {
          "anyOf": [
            {
              "$ref": "#/$defs/UnfinishedResearchView"
            },
            {
              "type": "null"
            }
          ]
        },
        "action": {
          "const": "buy",
          "title": "Action",
          "type": "string"
        },
        "timing": {
          "enum": [
            "at_current_limit",
            "wait_limit",
            "place_limit"
          ],
          "title": "Timing",
          "type": "string"
        },
        "terms": {
          "anyOf": [
            {
              "$ref": "#/$defs/SavedLimitTermsView"
            },
            {
              "type": "null"
            }
          ]
        },
        "proposed_limit_yen": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Proposed Limit Yen"
        },
        "terms_unavailable_reasons": {
          "items": {
            "$ref": "#/$defs/SavedReasonView"
          },
          "title": "Terms Unavailable Reasons",
          "type": "array"
        }
      },
      "required": [
        "ticker",
        "rationale",
        "review_conditions",
        "assessment",
        "saved_quote",
        "liquidity",
        "unfinished",
        "action",
        "timing",
        "terms",
        "proposed_limit_yen",
        "terms_unavailable_reasons"
      ],
      "title": "SavedBuyItemView",
      "type": "object"
    },
    "SavedDeferItemView": {
      "properties": {
        "ticker": {
          "title": "Ticker",
          "type": "string"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "review_conditions": {
          "items": {
            "type": "string"
          },
          "title": "Review Conditions",
          "type": "array"
        },
        "assessment": {
          "anyOf": [
            {
              "$ref": "#/$defs/SavedAssessmentView"
            },
            {
              "type": "null"
            }
          ]
        },
        "saved_quote": {
          "anyOf": [
            {
              "$ref": "#/$defs/SavedQuoteView"
            },
            {
              "type": "null"
            }
          ]
        },
        "liquidity": {
          "anyOf": [
            {
              "$ref": "#/$defs/SavedLiquidityView"
            },
            {
              "type": "null"
            }
          ]
        },
        "unfinished": {
          "anyOf": [
            {
              "$ref": "#/$defs/UnfinishedResearchView"
            },
            {
              "type": "null"
            }
          ]
        },
        "action": {
          "const": "defer",
          "title": "Action",
          "type": "string"
        },
        "blockers": {
          "items": {
            "$ref": "#/$defs/SavedReasonView"
          },
          "title": "Blockers",
          "type": "array"
        },
        "resume_conditions": {
          "items": {
            "type": "string"
          },
          "title": "Resume Conditions",
          "type": "array"
        }
      },
      "required": [
        "ticker",
        "rationale",
        "review_conditions",
        "assessment",
        "saved_quote",
        "liquidity",
        "unfinished",
        "action",
        "blockers",
        "resume_conditions"
      ],
      "title": "SavedDeferItemView",
      "type": "object"
    },
    "SavedExposureRowView": {
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "prospective_pct": {
          "title": "Prospective Pct",
          "type": "string"
        },
        "warning_pct": {
          "title": "Warning Pct",
          "type": "string"
        }
      },
      "required": [
        "key",
        "prospective_pct",
        "warning_pct"
      ],
      "title": "SavedExposureRowView",
      "type": "object"
    },
    "SavedHoldItemView": {
      "properties": {
        "ticker": {
          "title": "Ticker",
          "type": "string"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "review_conditions": {
          "items": {
            "type": "string"
          },
          "title": "Review Conditions",
          "type": "array"
        },
        "assessment": {
          "anyOf": [
            {
              "$ref": "#/$defs/SavedAssessmentView"
            },
            {
              "type": "null"
            }
          ]
        },
        "saved_quote": {
          "anyOf": [
            {
              "$ref": "#/$defs/SavedQuoteView"
            },
            {
              "type": "null"
            }
          ]
        },
        "liquidity": {
          "anyOf": [
            {
              "$ref": "#/$defs/SavedLiquidityView"
            },
            {
              "type": "null"
            }
          ]
        },
        "unfinished": {
          "anyOf": [
            {
              "$ref": "#/$defs/UnfinishedResearchView"
            },
            {
              "type": "null"
            }
          ]
        },
        "original_assessment": {
          "anyOf": [
            {
              "$ref": "#/$defs/SavedAssessmentView"
            },
            {
              "type": "null"
            }
          ]
        },
        "original_investment_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Original Investment Reason"
        },
        "original_reason_unavailable_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Original Reason Unavailable Reason"
        },
        "case_reassessment_reason": {
          "title": "Case Reassessment Reason",
          "type": "string"
        },
        "remaining_reward": {
          "anyOf": [
            {
              "$ref": "#/$defs/SavedRemainingRewardView"
            },
            {
              "type": "null"
            }
          ]
        },
        "action": {
          "const": "hold",
          "title": "Action",
          "type": "string"
        },
        "holding_basis": {
          "enum": [
            "investment_case_intact",
            "sufficient_remaining_reward"
          ],
          "title": "Holding Basis",
          "type": "string"
        },
        "return_calculation_unavailable_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Return Calculation Unavailable Reason"
        }
      },
      "required": [
        "ticker",
        "rationale",
        "review_conditions",
        "assessment",
        "saved_quote",
        "liquidity",
        "unfinished",
        "original_assessment",
        "original_investment_reason",
        "original_reason_unavailable_reason",
        "case_reassessment_reason",
        "remaining_reward",
        "action",
        "holding_basis",
        "return_calculation_unavailable_reason"
      ],
      "title": "SavedHoldItemView",
      "type": "object"
    },
    "SavedLimitTermsView": {
      "properties": {
        "limit_price_yen": {
          "title": "Limit Price Yen",
          "type": "string"
        },
        "quantity": {
          "title": "Quantity",
          "type": "integer"
        },
        "notional_yen": {
          "title": "Notional Yen",
          "type": "string"
        },
        "target_session": {
          "format": "date",
          "title": "Target Session",
          "type": "string"
        },
        "valuation_as_of": {
          "format": "date",
          "title": "Valuation As Of",
          "type": "string"
        },
        "maximum_entry_price_yen": {
          "anyOf": [
