{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "execution-lifecycle",
  "$defs": {
    "BrokerExecution": {
      "additionalProperties": false,
      "description": "An immutable execution fact confirmed by the broker.",
      "properties": {
        "execution_id": {
          "minLength": 1,
          "title": "Execution Id",
          "type": "string"
        },
        "order_id": {
          "minLength": 1,
          "title": "Order Id",
          "type": "string"
        },
        "side": {
          "enum": [
            "buy",
            "sell"
          ],
          "title": "Side",
          "type": "string"
        },
        "quantity": {
          "exclusiveMinimum": 0,
          "title": "Quantity",
          "type": "integer"
        },
        "price_yen": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,4}0*$",
              "type": "string"
            }
          ],
          "title": "Price Yen"
        },
        "executed_at": {
          "format": "date-time",
          "title": "Executed At",
          "type": "string"
        }
      },
      "required": [
        "execution_id",
        "order_id",
        "side",
        "quantity",
        "price_yen",
        "executed_at"
      ],
      "title": "BrokerExecution",
      "type": "object"
    },
    "BrokerOrder": {
      "additionalProperties": false,
      "description": "A manually submitted broker order under one decision intent.",
      "properties": {
        "order_id": {
          "minLength": 1,
          "title": "Order Id",
          "type": "string"
        },
        "origin_intent_id": {
          "minLength": 1,
          "title": "Origin Intent Id",
          "type": "string"
        },
        "external_broker_order_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "External Broker Order Id"
        },
        "submitted_at": {
          "format": "date-time",
          "title": "Submitted At",
          "type": "string"
        },
        "submitted_quantity": {
          "exclusiveMinimum": 0,
          "title": "Submitted Quantity",
          "type": "integer"
        },
        "limit_price_yen": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,4}0*$",
              "type": "string"
            }
          ],
          "title": "Limit Price Yen"
        },
        "terminal_status": {
          "anyOf": [
            {
              "enum": [
                "broker_rejected",
                "cancelled",
                "expired"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Terminal Status"
        },
        "terminal_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Terminal At"
        }
      },
      "required": [
        "order_id",
        "origin_intent_id",
        "external_broker_order_id",
        "submitted_at",
        "submitted_quantity",
        "limit_price_yen",
        "terminal_status",
        "terminal_at"
      ],
      "title": "BrokerOrder",
      "type": "object"
    },
    "DecisionIntent": {
      "additionalProperties": false,
      "description": "A human-confirmed execution instruction bound to one decision packet.",
      "properties": {
        "intent_id": {
          "minLength": 1,
          "title": "Intent Id",
          "type": "string"
        },
        "decision_reference": {
          "minLength": 1,
          "title": "Decision Reference",
          "type": "string"
        },
        "decision_packet_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Decision Packet Sha256",
          "type": "string"
        },
        "confirmed_at": {
          "format": "date-time",
          "title": "Confirmed At",
          "type": "string"
        },
        "side": {
          "enum": [
            "buy",
            "sell"
          ],
          "title": "Side",
          "type": "string"
        },
        "quantity": {
          "exclusiveMinimum": 0,
          "title": "Quantity",
          "type": "integer"
        },
        "price_guard_yen": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,4}0*$",
              "type": "string"
            }
          ],
          "title": "Price Guard Yen"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "uses_margin": {
          "const": false,
          "title": "Uses Margin",
          "type": "boolean"
        }
      },
      "required": [
        "intent_id",
        "decision_reference",
        "decision_packet_sha256",
        "confirmed_at",
        "side",
        "quantity",
        "price_guard_yen",
        "expires_at",
        "uses_margin"
      ],
      "title": "DecisionIntent",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Versioned contract for one ticker's human-approved execution lifecycle.",
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "position_id": {
      "minLength": 1,
      "title": "Position Id",
      "type": "string"
    },
    "ticker": {
      "pattern": "^[0-9A-Z]{4}$",
      "title": "Ticker",
      "type": "string"
    },
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "decision_intents": {
      "items": {
        "$ref": "#/$defs/DecisionIntent"
      },
      "title": "Decision Intents",
      "type": "array"
    },
    "orders": {
      "items": {
        "$ref": "#/$defs/BrokerOrder"
      },
      "title": "Orders",
      "type": "array"
    },
    "executions": {
      "items": {
        "$ref": "#/$defs/BrokerExecution"
      },
      "title": "Executions",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "position_id",
    "ticker",
    "as_of",
    "decision_intents",
    "orders",
    "executions"
  ],
  "title": "ExecutionLifecycleDocument",
  "type": "object"
}
