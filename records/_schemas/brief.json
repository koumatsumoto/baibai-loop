{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "brief",
  "title": "Brief YAML",
  "description": "Schema for records/02-brief/**/*.yaml. Captures macro fact briefs structured by world / japan / japan_equity layers with explicit source references and threshold-driven deltas.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "type",
    "scope",
    "ai_draft",
    "published_at",
    "observation_date",
    "sources",
    "layers",
    "next_events"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {
      "type": "string",
      "enum": [
        "world-daily",
        "world-weekly",
        "macro-monthly",
        "fomc",
        "boj",
        "cpi",
        "gdp",
        "geopolitics",
        "event"
      ]
    },
    "type": {"enum": ["periodic", "event"]},
    "scope": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(world|japan|sector-[a-z0-9-]+)$"
    },
    "ai_draft": {"type": "boolean"},
    "published_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:[+-][0-9]{2}:[0-9]{2}|Z)$"
    },
    "observation_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "end": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "market_basis_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "note": {"type": "string"}
      }
    },
    "month": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
    "references": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prev_period": {"type": ["string", "null"]},
        "prev_year_same_period": {"type": ["string", "null"]},
        "latest_monthly": {"type": ["string", "null"]},
        "latest_weekly": {"type": ["string", "null"]},
        "latest_daily": {"type": ["string", "null"]},
        "related_briefs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/Source"}
    },
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["world", "japan", "japan_equity"],
      "properties": {
        "world": {"$ref": "#/$defs/Layer"},
        "japan": {"$ref": "#/$defs/Layer"},
        "japan_equity": {"$ref": "#/$defs/Layer"}
      }
    },
    "deltas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["threshold_breaches", "direction_history"],
      "properties": {
        "threshold_breaches": {
          "type": "array",
          "items": {"$ref": "#/$defs/Breach"}
        },
        "unjudgeable": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "direction_history": {
          "type": "array",
          "items": {"$ref": "#/$defs/DirectionHistoryEntry"}
        },
        "direction_reversals": {
          "type": "array",
          "items": {"$ref": "#/$defs/DirectionReversalEntry"}
        },
        "insufficient_data_reason": {"type": "string"}
      }
    },
    "fact_memos": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "next_events": {
      "type": "array",
      "items": {"$ref": "#/$defs/Event"}
    },
    "notes": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"enum": ["world-weekly", "macro-monthly"]}}},
      "then": {"required": ["deltas"]}
    },
    {
      "if": {"properties": {"kind": {"const": "macro-monthly"}}},
      "then": {"required": ["month"]}
    },
    {
      "if": {"properties": {"kind": {"const": "world-weekly"}}},
      "then": {"required": ["period"]}
    }
  ],
  "$defs": {
    "Source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "url", "accessed_at", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "name": {"type": "string", "minLength": 1},
        "url": {"type": "string", "minLength": 1},
        "accessed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "status": {"enum": ["ok", "partial", "failed"]},
        "note": {"type": "string"}
      }
    },
    "Layer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "market_indicators": {
          "type": "array",
          "items": {"$ref": "#/$defs/Indicator"}
        },
        "fx": {
          "type": "array",
          "items": {"$ref": "#/$defs/Indicator"}
        },
        "monthly_statistics": {
          "type": "array",
          "items": {"$ref": "#/$defs/MonthlyStatistic"}
        },
        "policy_rates": {
          "type": "array",
          "items": {"$ref": "#/$defs/MonthlyStatistic"}
        },
        "sector_movements": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "array",
              "items": {"$ref": "#/$defs/SectorMovement"}
            }
          ]
        },
        "events": {
          "type": "array",
          "items": {"$ref": "#/$defs/Event"}
        },
        "note": {"type": "string"}
      }
    },
    "Indicator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "source_ids"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "value": {"type": ["string", "number", "null"]},
        "as_of": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "wow_comment": {"type": "string"},
        "fetch_status": {"enum": ["ok", "failed"]},
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "MonthlyStatistic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "source_ids"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "value": {"type": ["string", "number", "null"]},
        "previous": {"type": ["string", "number", "null"]},
        "release_date": {"type": ["string", "null"], "minLength": 1},
        "fetch_status": {"enum": ["ok", "failed", "unreleased"]},
        "note": {"type": "string"},
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "SectorMovement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bucket", "sector", "change", "source_ids"],
      "properties": {
        "bucket": {"enum": ["top", "bottom"]},
        "sector": {"type": "string", "minLength": 1},
        "change": {"type": ["string", "number"]},
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "Event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "text"],
      "properties": {
        "date": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "source_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "Breach": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "indicator", "from", "to"],
      "properties": {
        "severity": {"enum": ["notable", "major"]},
        "indicator": {"type": "string", "minLength": 1},
        "from": {"type": ["string", "number"]},
        "to": {"type": ["string", "number"]},
        "change": {"type": ["string", "number"]}
      }
    },
    "DirectionHistoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["indicator"],
      "properties": {
        "indicator": {"type": "string", "minLength": 1},
        "history": {"type": "string"},
        "insufficient_data": {"type": "boolean"},
        "reason": {"type": "string"}
      }
    },
    "DirectionReversalEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["indicator"],
      "properties": {
        "indicator": {"type": "string", "minLength": 1},
        "reversal_date": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "from_direction": {"enum": ["up", "down", "flat"]},
        "to_direction": {"enum": ["up", "down", "flat"]},
        "weeks_after_reversal": {"type": "integer", "minimum": 0},
        "insufficient_data": {"type": "boolean"},
        "reason": {"type": "string"}
      }
    }
  }
}
