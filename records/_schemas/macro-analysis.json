{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "macro-analysis",
  "title": "Macro Analysis",
  "description": "Schema for records/02-macro-analysis/**/*.yaml. A dated, sourced macro/market research output, grounded in stats series, that names the trade-relevant levers it drives.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "analysis_id",
    "as_of",
    "published_at",
    "question",
    "summary",
    "horizon",
    "data_inputs",
    "sources",
    "scenarios",
    "risks",
    "forward_view",
    "risk_posture",
    "trade_levers",
    "confidence"
  ],
  "properties": {
    "kind": {"const": "macro-analysis"},
    "analysis_id": {"type": "string", "pattern": "^macro-analysis-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+$"},
    "as_of": {"type": "string", "format": "date"},
    "published_at": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "horizon": {"enum": ["2w", "1m", "3m", "6m", "12m", "long"]},
    "data_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/DataInput"}
    },
    "sources": {
      "type": "array",
      "items": {"$ref": "#/$defs/Source"}
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/Scenario"}
    },
    "risks": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "forward_view": {"type": "string", "minLength": 1},
    "risk_posture": {"$ref": "#/$defs/RiskPosture"},
    "trade_levers": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/TradeLever"}
    },
    "confidence": {"enum": ["low", "medium", "high"]}
  },
  "$defs": {
    "DataInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["series_id", "window", "observation", "used_for"],
      "properties": {
        "series_id": {"type": "string", "minLength": 1},
        "window": {"type": "string", "minLength": 1},
        "observation": {"type": "string", "minLength": 1},
        "used_for": {"type": "string", "minLength": 1}
      }
    },
    "Source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "title", "url", "published_at", "used_for"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "url": {"type": "string", "minLength": 1},
        "published_at": {"type": "string", "minLength": 1},
        "used_for": {"type": "string", "minLength": 1}
      }
    },
    "Scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "narrative"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "probability": {"type": "number", "minimum": 0, "maximum": 1},
        "narrative": {"type": "string", "minLength": 1}
      }
    },
    "RiskPosture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stance", "rationale"],
      "properties": {
        "stance": {"enum": ["risk_on", "neutral", "risk_off"]},
        "gross_guidance": {"type": "string", "minLength": 1},
        "cash_floor_pct": {"type": "number", "minimum": 0, "maximum": 100},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "TradeLever": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lever", "target", "direction", "rationale"],
      "properties": {
        "lever": {"enum": ["sector_tilt", "risk_posture", "theme", "timing", "universe_attention"]},
        "target": {"type": "string", "minLength": 1},
        "direction": {"enum": ["favor", "avoid", "neutral", "increase", "decrease"]},
        "rationale": {"type": "string", "minLength": 1}
      }
    }
  }
}
