{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portfolio-policy",
  "title": "Portfolio Policy",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "policy_id",
    "effective_from",
    "policy_origin",
    "capital_basis",
    "risk_budget",
    "minimum_payoff",
    "execution_scaling",
    "policy_rules"
  ],
  "properties": {
    "policy_id": {"type": "string", "minLength": 1},
    "effective_from": {"type": "string", "format": "date-time"},
    "policy_origin": {"enum": ["codified_post_hoc", "drafted_ex_ante"]},
    "capital_basis": {"type": "object"},
    "risk_budget": {"type": "object"},
    "minimum_payoff": {"type": "object"},
    "execution_scaling": {"type": "object"},
    "policy_rules": {"type": "object"}
  }
}
