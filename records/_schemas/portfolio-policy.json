{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portfolio-policy",
  "title": "Portfolio Policy",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "policy_id",
    "effective_from",
    "policy_origin",
    "capital_basis",
    "risk_budget",
    "minimum_payoff",
    "execution_scaling",
    "conviction_tier_caps",
    "evidence_count_caps",
    "policy_rules"
  ],
  "properties": {
    "policy_id": {"type": "string", "minLength": 1},
    "effective_from": {"type": "string", "format": "date-time"},
    "policy_origin": {"enum": ["codified_post_hoc", "drafted_ex_ante"]},
    "capital_basis": {"type": "object"},
    "risk_budget": {"type": "object"},
    "minimum_payoff": {"type": "object"},
    "execution_scaling": {"type": "object"},
    "conviction_tier_caps": {"type": "object"},
    "evidence_count_caps": {
      "type": "object",
      "required": ["count_1"],
      "properties": {
        "count_1": {
          "type": "object",
          "required": [
            "max_real_order_notional_yen",
            "requires_disconfirming_or_risk_evidence",
            "requires_payoff_confirmation"
          ],
          "properties": {
            "max_real_order_notional_yen": {"type": "number", "exclusiveMinimum": 0},
            "requires_disconfirming_or_risk_evidence": {"type": "boolean"},
            "requires_payoff_confirmation": {"type": "boolean"}
          }
        }
      }
    },
    "policy_rules": {"type": "object"}
  }
}
