{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade",
  "title": "Trade",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "trade_id",
    "ticker",
    "research_ref",
    "policy_ref",
    "policy_applicability",
    "calendar_refs",
    "portfolio_exposure_ref",
    "position_state",
    "review_state",
    "trade_execution_state",
    "order_intent",
    "position_sizing_overlay",
    "orders",
    "executions"
  ],
  "properties": {
    "trade_id": {"type": "string", "minLength": 1},
    "ticker": {"type": "string", "pattern": "^[0-9A-Z]{4}$"},
    "research_ref": {"type": "string", "pattern": "^records/05-research/[^.][^\\n]*\\.md$"},
    "policy_ref": {"$ref": "#/$defs/RepositoryRef"},
    "portfolio_exposure_ref": {"$ref": "#/$defs/RepositoryRef"},
    "policy_applicability": {"enum": ["active"]},
    "calendar_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["business_days", "events", "corporate_actions"],
      "properties": {
        "business_days": {"$ref": "#/$defs/RepositoryRef"},
        "events": {"$ref": "#/$defs/RepositoryRef"},
        "corporate_actions": {"$ref": "#/$defs/RepositoryRef"}
      }
    },
    "position_state": {"enum": ["none", "open", "closed"]},
    "review_state": {"enum": ["not_due", "scheduled", "completed"]},
    "trade_execution_state": {
      "enum": ["none", "submitted", "broker_rejected", "cancelled", "expired", "not_filled", "partially_filled", "filled"]
    },
    "order_intent": {
      "type": "object",
      "properties": {
        "order_intent_id": {"type": "string", "minLength": 1},
        "decision_event_id": {"type": "string", "minLength": 1},
        "side": {"enum": ["buy", "sell"]},
        "quantity": {"type": "number"},
        "order_price_guard_yen": {"type": "number"},
        "uses_margin": {"type": "boolean"}
      }
    },
    "position_sizing_overlay": {
      "type": "object",
      "properties": {
        "estimated_real_order_notional_yen": {"type": "number"},
        "guarded_max_notional_yen": {"type": "number"}
      }
    },
    "orders": {
      "type": "array",
      "items": {"type": "object"}
    },
    "executions": {"type": "array"}
  },
  "$defs": {
    "RepositoryRef": {
      "type": "object",
      "additionalProperties": true,
      "required": ["ref_path"],
      "not": {
        "anyOf": [
          {"required": ["content_sha256"]},
          {"required": ["row_sha256"]}
        ]
      },
      "properties": {
        "ref_path": {"type": "string", "minLength": 1, "pattern": "^records/[^\\n]*$"},
        "effective_from": {"type": "string"},
        "as_of": {"type": "string"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["trade_execution_state"],
        "properties": {
          "trade_execution_state": {"not": {"const": "none"}}
        }
      },
      "then": {
        "properties": {
          "position_sizing_overlay": {
            "required": [
              "estimated_real_order_notional_yen",
              "guarded_max_notional_yen"
            ]
          }
        }
      }
    }
  ]
}
