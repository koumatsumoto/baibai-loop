{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade",
  "title": "Trade",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "trade_id",
    "ticker",
    "research_ref",
    "policy_snapshot",
    "policy_applicability",
    "calendars_snapshot",
    "portfolio_exposure_snapshot_ref",
    "position_state",
    "review_state",
    "trade_execution_state",
    "order_intent",
    "position_sizing_overlay",
    "orders",
    "executions"
  ],
  "properties": {
    "trade_id": {"type": "string", "minLength": 1},
    "ticker": {"type": "string", "pattern": "^[0-9A-Z]{4}$"},
    "research_ref": {"type": "string", "pattern": "^records/05-research/.*\\.md$"},
    "policy_applicability": {"enum": ["active"]},
    "calendars_snapshot": {"type": "object"},
    "position_state": {"enum": ["none", "open", "closed"]},
    "review_state": {"enum": ["not_due", "scheduled", "completed"]},
    "trade_execution_state": {
      "enum": ["none", "submitted", "broker_rejected", "cancelled", "expired", "not_filled", "partially_filled", "filled"]
    },
    "order_intent": {
      "type": "object",
      "properties": {
        "order_intent_id": {"type": "string", "minLength": 1},
        "decision_event_id": {"type": "string", "minLength": 1},
        "side": {"enum": ["buy", "sell"]},
        "quantity": {"type": "number"},
        "order_price_guard_yen": {"type": "number"},
        "uses_margin": {"type": "boolean"}
      }
    },
    "position_sizing_overlay": {
      "type": "object",
      "properties": {
        "estimated_real_order_notional_yen": {"type": "number"},
        "guarded_max_notional_yen": {"type": "number"}
      }
    },
    "orders": {
      "type": "array",
      "items": {"type": "object"}
    },
    "executions": {"type": "array"}
  },
  "allOf": [
    {
      "if": {
        "required": ["trade_execution_state"],
        "properties": {
          "trade_execution_state": {"not": {"const": "none"}}
        }
      },
      "then": {
        "properties": {
          "position_sizing_overlay": {
            "required": [
              "estimated_real_order_notional_yen",
              "guarded_max_notional_yen"
            ]
          }
        }
      }
    }
  ]
}
