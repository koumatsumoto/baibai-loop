{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade",
  "title": "Trade",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "trade_id",
    "ticker",
    "research_ref",
    "position_state",
    "trade_execution_state",
    "order_intent",
    "orders",
    "executions"
  ],
  "properties": {
    "trade_id": {"type": "string", "minLength": 1},
    "ticker": {"type": "string", "pattern": "^[0-9A-Z]{4}$"},
    "research_ref": {"type": "string", "pattern": "^records/05-research/[^.][^\\n]*\\.md$"},
    "position_state": {"enum": ["none", "open", "closed"]},
    "review_state": {"enum": ["not_due", "scheduled", "completed"]},
    "trade_execution_state": {
      "enum": ["none", "submitted", "broker_rejected", "cancelled", "expired", "not_filled", "partially_filled", "filled"]
    },
    "order_intent": {
      "type": "object",
      "properties": {
        "order_intent_id": {"type": "string", "minLength": 1},
        "decision_event_id": {"type": "string", "minLength": 1},
        "side": {"enum": ["buy", "sell"]},
        "quantity": {"type": "number"},
        "order_price_guard_yen": {"type": "number"},
        "uses_margin": {"type": "boolean"}
      }
    },
    "position_sizing_overlay": {
      "type": "object",
      "properties": {
        "estimated_real_order_notional_yen": {"type": "number"},
        "guarded_max_notional_yen": {"type": "number"}
      }
    },
    "orders": {
      "type": "array",
      "items": {"type": "object"}
    },
    "executions": {"type": "array"}
  },
  "$defs": {
    "RepositoryRef": {
      "type": "object",
      "additionalProperties": true,
      "required": ["ref_path"],
      "properties": {
        "ref_path": {"type": "string", "minLength": 1, "pattern": "^records/[^\\n]*$"},
        "effective_from": {"type": "string"},
        "as_of": {"type": "string"}
      }
    }
  }
}
