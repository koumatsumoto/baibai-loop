{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade",
  "title": "Trade",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trade_id",
    "ticker",
    "research_ref",
    "position_state",
    "trade_execution_state",
    "order_intent",
    "orders",
    "executions"
  ],
  "properties": {
    "trade_id": {"type": "string", "minLength": 1},
    "ticker": {"type": "string", "pattern": "^[0-9A-Z]{4}$"},
    "name": {"type": "string"},
    "playbook_id": {"type": "string"},
    "research_ref": {"type": "string", "pattern": "^records/05-research/[^.][^\\n]*\\.md$"},
    "cohort_tag": {"type": "string", "minLength": 1},
    "position_state": {"enum": ["none", "open", "closed"]},
    "current_quantity": {"type": "number"},
    "trade_execution_state": {
      "enum": ["none", "submitted", "broker_rejected", "cancelled", "expired", "not_filled", "partially_filled", "filled"]
    },
    "order_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order_intent_id",
        "decision_event_id",
        "side",
        "quantity",
        "order_price_guard_yen",
        "uses_margin"
      ],
      "properties": {
        "order_intent_id": {"type": "string", "minLength": 1},
        "decision_event_id": {"type": "string", "minLength": 1},
        "side": {"enum": ["buy", "sell"]},
        "quantity": {"type": "number"},
        "order_price_guard_yen": {"type": "number"},
        "uses_margin": {"type": "boolean"},
        "expires_at": {"type": ["string", "null"]},
        "not_submitted_reason": {"type": ["string", "null"]}
      }
    },
    "position_sizing_overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["estimated_real_order_notional_yen", "guarded_max_notional_yen"],
      "properties": {
        "estimated_real_order_notional_yen": {"type": "number"},
        "guarded_max_notional_yen": {"type": "number"}
      }
    },
    "orders": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order_id",
          "origin_order_intent_id",
          "side",
          "state",
          "submitted_quantity",
          "filled_quantity",
          "order_price_guard_yen"
        ],
        "properties": {
          "order_id": {"type": "string", "minLength": 1},
          "origin_order_intent_id": {"type": "string", "minLength": 1},
          "external_broker_order_id": {"type": ["string", "null"]},
          "side": {"enum": ["buy", "sell"]},
          "state": {
            "enum": [
              "submitted",
              "broker_rejected",
              "cancelled",
              "expired",
              "not_filled",
              "partially_filled",
              "filled"
            ]
          },
          "submitted_quantity": {"type": "number"},
          "filled_quantity": {"type": "number"},
          "order_price_guard_yen": {"type": "number"}
        }
      }
    },
    "executions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["execution_id", "order_id", "side", "quantity", "price_yen", "at"],
        "properties": {
          "execution_id": {"type": "string", "minLength": 1},
          "order_id": {"type": "string", "minLength": 1},
          "side": {"enum": ["buy", "sell"]},
          "quantity": {"type": "number"},
          "price_yen": {"type": "number"},
          "at": {"type": "string"}
        }
      }
    },
    "entry_legs": {"type": "array", "items": {"type": "object"}},
    "capital_basis": {"type": "object"},
    "planned_exit": {"type": "object"},
    "kill_switch_check": {"type": "object"},
    "accounting": {"type": "object"},
    "execution_costs": {"type": "object"}
  },
  "$defs": {
    "RepositoryRef": {
      "type": "object",
      "additionalProperties": true,
      "required": ["ref_path"],
      "properties": {
        "ref_path": {"type": "string", "minLength": 1, "pattern": "^records/[^\\n]*$"},
        "effective_from": {"type": "string"},
        "as_of": {"type": "string"}
      }
    }
  }
}
