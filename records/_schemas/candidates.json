{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "candidates",
  "title": "Candidates",
  "description": "Schema for records/04-candidates/**/*.yaml screen output.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "run_date",
    "asof_date",
    "run_at",
    "run_id",
    "candidates"
  ],
  "properties": {
    "run_date": {"type": "string"},
    "asof_date": {"type": "string"},
    "run_at": {"type": "string"},
    "run_id": {"type": "string", "pattern": "^screening-[0-9]{8}$"},
    "candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/Candidate"}
    },
    "evidence_hits_summary": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    }
  },
  "$defs": {
    "Candidate": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "ticker",
        "name",
        "evidence_hits"
      ],
      "properties": {
        "ticker": {"type": "string", "pattern": "^[0-9A-Z]{4}$"},
        "name": {"type": "string", "minLength": 1},
        "evidence_hits": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/EvidenceHit"}
        }
      }
    },
    "EvidenceHit": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "name",
        "playbook_id",
        "source_status",
        "sizing_eligible"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "playbook_id": {"type": "string", "minLength": 1},
        "source_status": {"enum": ["ok", "warning", "stale", "missing"]},
        "sizing_eligible": {"type": "boolean"}
      }
    }
  }
}
