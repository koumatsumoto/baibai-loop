{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "thesis",
  "title": "Investment Memo",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ticker",
    "name",
    "playbook_id",
    "playbook_ref",
    "thesis_decision",
    "candidate_ref",
    "position_sizing_overlay",
    "thesis_payoff",
    "corporate_action_check"
  ],
  "properties": {
    "ticker": {"type": "string", "pattern": "^[0-9A-Z]{4}$"},
    "name": {"type": "string", "minLength": 1},
    "sector_33": {"type": "string", "minLength": 1},
    "playbook_id": {"type": "string", "minLength": 1},
    "playbook_ref": {"$ref": "#/$defs/RepositoryRef"},
    "candidate_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidates_ref", "ticker"],
      "properties": {
        "candidates_ref": {"type": "string", "pattern": "^records/02-candidates/[^\\n]*\\.ya?ml$"},
        "ticker": {"type": "string", "pattern": "^[0-9A-Z]{4}$"}
      }
    },
    "thesis_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "posture"],
      "properties": {
        "outcome": {"enum": ["approved", "deferred", "rejected"]},
        "posture": {"enum": ["act_now", "wait_for_event", "wait_for_capital", "dropped"]},
        "reason_code": {"type": "string"},
        "rejection_reason": {"type": "string"},
        "deferral_reason": {"type": "string"},
        "revisit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "trigger": {"type": "string"},
            "revisit_after": {"type": "string", "format": "date"},
            "expires_at": {"type": "string", "format": "date"},
            "blocking_conditions": {
              "type": "array",
              "items": {"type": "string"}
            }
          }
        }
      }
    },
    "corporate_action_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checked", "result"],
      "properties": {
        "checked": {"type": "boolean"},
        "result": {"enum": ["none", "found", "not_applicable"]},
        "note": {"type": "string"}
      }
    },
    "position_sizing_overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estimated_real_order_notional_yen",
        "adv_participation_pct"
      ],
      "properties": {
        "estimated_real_order_notional_yen": {"type": "number"},
        "guarded_max_notional_yen": {"type": "number"},
        "adv_participation_pct": {"type": "number"}
      }
    },
    "valuation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "per_forward": {"type": ["number", "null"]},
        "per_trailing": {"type": ["number", "null"]},
        "pbr": {"type": ["number", "null"]},
        "ev_ebitda": {"type": ["number", "null"]},
        "p_s": {"type": ["number", "null"]},
        "pcfr": {"type": ["number", "null"]},
        "ocf_yield": {"type": ["number", "null"]},
        "fcf_yield": {"type": ["number", "null"]},
        "net_cash_to_market_cap": {"type": ["number", "null"]},
        "cash_to_market_cap": {"type": ["number", "null"]},
        "price_to_equity": {"type": ["number", "null"]},
        "equity_ratio": {"type": ["number", "null"]},
        "primary_metric": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "durability_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "net_cash",
        "operating_cf_positive",
        "low_leverage",
        "refinancing_risk",
        "judgment"
      ],
      "properties": {
        "net_cash": {"type": "boolean"},
        "operating_cf_positive": {"type": "boolean"},
        "low_leverage": {"type": "boolean"},
        "refinancing_risk": {"enum": ["low", "medium", "high"]},
        "dividend": {"type": "boolean"},
        "judgment": {"enum": ["high", "medium", "low"]},
        "note": {"type": "string"}
      }
    },
    "entry_preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluated_on",
        "market_relative_return_pct",
        "sector_or_peer_relative_return_pct",
        "exposure_after_order",
        "action",
        "reason"
      ],
      "properties": {
        "evaluated_on": {"type": "string", "format": "date"},
        "market_relative_return_pct": {"type": "number"},
        "sector_or_peer_relative_return_pct": {"type": ["number", "null"]},
        "exposure_after_order": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sector_33_pct", "playbook_pct"],
          "properties": {
            "sector_33_pct": {"type": "number"},
            "playbook_pct": {"type": "number"}
          }
        },
        "action": {"enum": ["proceed", "starter", "defer"]},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "thesis_payoff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_entry_price_yen": {"type": ["number", "null"]},
        "fair_value_yen": {"type": ["number", "null"]},
        "expected_upside_pct": {"type": ["number", "null"]},
        "expected_downside_pct": {"type": ["number", "null"]},
        "risk_reward_ratio": {"type": ["number", "null"]},
        "expected_yield_pct": {"type": ["number", "null"]},
        "invalidation_conditions": {
          "type": "array",
          "items": {"type": "string"}
        },
        "entry_trigger": {"type": "string"}
      }
    },
    "avg_turnover_oku": {"type": ["number", "null"]},
    "market_cap_oku": {"type": ["number", "null"]},
    "published_at": {"type": "string"},
    "recorded_at": {"type": "string"},
    "tradable_at": {"type": ["string", "null"]}
  },
  "$defs": {
    "RepositoryRef": {
      "type": "object",
      "additionalProperties": true,
      "required": ["ref_path"],
      "properties": {
        "ref_path": {"type": "string", "minLength": 1, "pattern": "^records/[^\\n]*$"},
        "effective_from": {"type": "string"},
        "as_of": {"type": "string"}
      }
    }
  }
}
