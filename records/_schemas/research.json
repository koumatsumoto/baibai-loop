{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research",
  "title": "Investment Memo",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "ticker",
    "name",
    "playbook_id",
    "playbook_ref",
    "research_decision",
    "candidate_ref",
    "macro_context_ref",
    "macro_context_fit",
    "candidate_evidence_decisions",
    "selected_supporting_evidence_refs",
    "research_evidence_hits",
    "independent_evidence_count",
    "conviction_tier",
    "position_sizing_overlay",
    "thesis_payoff"
  ],
  "properties": {
    "ticker": {"type": "string", "pattern": "^[0-9A-Z]{4}$"},
    "playbook_id": {"type": "string", "minLength": 1},
    "playbook_ref": {"$ref": "#/$defs/RepositoryRef"},
    "research_decision": {
      "type": "object",
      "required": ["outcome", "posture"],
      "properties": {
        "outcome": {"enum": ["approved", "deferred", "rejected"]},
        "posture": {"enum": ["act_now", "wait_for_event", "wait_for_capital", "dropped"]}
      }
    },
    "macro_context_ref": {"type": "string", "pattern": "^records/01-macro-context/[^\\n]*\\.ya?ml$"},
    "macro_context_fit": {
      "type": "object",
      "required": ["context_freshness", "fit", "decision_effect"],
      "properties": {
        "context_freshness": {"enum": ["current", "stale", "future"]},
        "fit": {"enum": ["tailwind", "neutral", "mixed", "headwind", "not_matched"]},
        "decision_effect": {"enum": ["proceed", "caution", "defer"]},
        "required_checks": {"type": "array"},
        "sizing_caution": {"type": "array"}
      }
    },
    "candidate_evidence_decisions": {"type": "array"},
    "research_evidence_hits": {"type": "array"},
    "conviction_tier": {"enum": ["low", "medium", "high"]},
    "conviction_tier_path": {"enum": ["count_breadth", "depth"]},
    "position_sizing_overlay": {
      "type": "object",
      "required": [
        "paper_proxy_position_size_yen",
        "real_order_intent_yen",
        "adv_participation_pct"
      ],
      "properties": {
        "paper_proxy_position_size_yen": {"type": "number"},
        "real_order_intent_yen": {"type": "number"},
        "adv_participation_pct": {"type": "number"}
      }
    },
    "thesis_payoff": {"type": "object"}
  },
  "$defs": {
    "RepositoryRef": {
      "type": "object",
      "additionalProperties": true,
      "required": ["ref_path"],
      "not": {
        "anyOf": [
          {"required": ["content_sha256"]},
          {"required": ["row_sha256"]}
        ]
      },
      "properties": {
        "ref_path": {"type": "string", "minLength": 1, "pattern": "^records/[^\\n]*$"},
        "effective_from": {"type": "string"},
        "as_of": {"type": "string"}
      }
    }
  }
}
