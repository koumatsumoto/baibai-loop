{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "market-data",
  "title": "Fallback Market Data",
  "type": "object",
  "additionalProperties": false,
  "required": ["observations"],
  "properties": {
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decision_event_id",
          "ticker",
          "tracking_horizon",
          "target_date",
          "resolved_trade_date",
          "price",
          "price_basis",
          "source_name",
          "source_url",
          "fetched_at",
          "corporate_action_checked",
          "same_basis_group_id",
          "provisional"
        ],
        "properties": {
          "decision_event_id": {"type": "string", "minLength": 1},
          "ticker": {"type": "string", "pattern": "^[0-9A-Z]{4}$"},
          "tracking_horizon": {"enum": ["plus_15bd", "plus_30bd"]},
          "target_date": {"type": "string", "format": "date"},
          "resolved_trade_date": {"type": "string", "format": "date"},
          "price": {"type": "number", "exclusiveMinimum": 0},
          "price_basis": {"enum": ["close_unadjusted", "adjusted_close", "intraday_last"]},
          "source_name": {"type": "string", "minLength": 1},
          "source_url": {"type": "string", "minLength": 1},
          "fetched_at": {"type": "string", "minLength": 1},
          "corporate_action_checked": {"type": "boolean"},
          "same_basis_group_id": {"type": "string", "minLength": 1},
          "provisional": {"type": "boolean"}
        }
      }
    }
  }
}
