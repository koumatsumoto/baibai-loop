{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "holding-review",
  "$defs": {
    "AddContext": {
      "additionalProperties": false,
      "properties": {
        "current_price_yen": {
          "exclusiveMinimum": 0,
          "title": "Current Price Yen",
          "type": "integer"
        },
        "max_acceptable_price_yen": {
          "exclusiveMinimum": 0,
          "title": "Max Acceptable Price Yen",
          "type": "integer"
        },
        "available_cash_yen": {
          "minimum": 0,
          "title": "Available Cash Yen",
          "type": "integer"
        },
        "concentration_ok": {
          "title": "Concentration Ok",
          "type": "boolean"
        }
      },
      "required": [
        "current_price_yen",
        "max_acceptable_price_yen",
        "available_cash_yen",
        "concentration_ok"
      ],
      "title": "AddContext",
      "type": "object"
    },
    "CandidateLeg": {
      "additionalProperties": false,
      "properties": {
        "ticker": {
          "pattern": "^[0-9A-Z]{4}$",
          "title": "Ticker",
          "type": "string"
        },
        "forward_5y_cagr_pct": {
          "exclusiveMinimum": -100,
          "maximum": 1000,
          "title": "Forward 5Y Cagr Pct",
          "type": "number"
        }
      },
      "required": [
        "ticker",
        "forward_5y_cagr_pct"
      ],
      "title": "CandidateLeg",
      "type": "object"
    },
    "Current5yEstimate": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "resolved",
            "unresolved"
          ],
          "title": "Status",
          "type": "string"
        },
        "forward_5y_cagr_pct": {
          "anyOf": [
            {
              "exclusiveMinimum": -100,
              "maximum": 1000,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Forward 5Y Cagr Pct"
        }
      },
      "required": [
        "status"
      ],
      "title": "Current5yEstimate",
      "type": "object"
    },
    "EvidenceFreshness": {
      "additionalProperties": false,
      "properties": {
        "latest_source_as_of": {
          "format": "date",
          "title": "Latest Source As Of",
          "type": "string"
        },
        "age_days": {
          "minimum": 0,
          "title": "Age Days",
          "type": "integer"
        }
      },
      "required": [
        "latest_source_as_of",
        "age_days"
      ],
      "title": "EvidenceFreshness",
      "type": "object"
    },
    "ExitTax": {
      "additionalProperties": false,
      "properties": {
        "tax_basis": {
          "enum": [
            "confirmed",
            "estimated",
            "unknown"
          ],
          "title": "Tax Basis",
          "type": "string"
        },
        "rate_bps": {
          "anyOf": [
            {
              "maximum": 10000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rate Bps"
        },
        "tax_yen": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tax Yen"
        },
        "estimated_exit_tax_basis": {
          "anyOf": [
            {
              "const": "ledger_fifo_gross_unrealized_gain",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Exit Tax Basis"
        }
      },
      "required": [
        "tax_basis"
      ],
      "title": "ExitTax",
      "type": "object"
    },
    "HoldLeg": {
      "additionalProperties": false,
      "properties": {
        "market_value_yen": {
          "exclusiveMinimum": 0,
          "title": "Market Value Yen",
          "type": "integer"
        },
        "deployed_cost_yen": {
          "minimum": 0,
          "title": "Deployed Cost Yen",
          "type": "integer"
        },
        "forward_5y_cagr_pct": {
          "exclusiveMinimum": -100,
          "maximum": 1000,
          "title": "Forward 5Y Cagr Pct",
          "type": "number"
        }
      },
      "required": [
        "market_value_yen",
        "deployed_cost_yen",
        "forward_5y_cagr_pct"
      ],
      "title": "HoldLeg",
      "type": "object"
    },
    "PermanentLossAxis": {
      "additionalProperties": false,
      "properties": {
        "axis": {
          "enum": [
            "funding_liquidity",
            "debt_repayment",
            "cash_flow",
            "dilution",
            "customer_concentration",
            "structural_decline",
            "governance_accounting"
          ],
          "title": "Axis",
          "type": "string"
        },
        "assessment": {
          "enum": [
            "acceptable",
            "adverse",
            "unknown"
          ],
          "title": "Assessment",
          "type": "string"
        },
        "evidence_status": {
          "enum": [
            "verified",
            "partially_verified",
            "unverified"
          ],
          "title": "Evidence Status",
          "type": "string"
        }
      },
      "required": [
        "axis",
        "assessment",
        "evidence_status"
      ],
      "title": "PermanentLossAxis",
      "type": "object"
    },
    "ReduceContext": {
      "additionalProperties": false,
      "properties": {
        "concentration_exceeded": {
          "title": "Concentration Exceeded",
          "type": "boolean"
        }
      },
      "required": [
        "concentration_exceeded"
      ],
      "title": "ReduceContext",
      "type": "object"
    },
    "ReplacementComparison": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "no_candidate",
            "evaluated"
          ],
          "title": "Status",
          "type": "string"
        },
        "hold": {
          "anyOf": [
            {
              "$ref": "#/$defs/HoldLeg"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "candidate": {
          "anyOf": [
            {
              "$ref": "#/$defs/CandidateLeg"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "exit_tax": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExitTax"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "status"
      ],
      "title": "ReplacementComparison",
      "type": "object"
    },
    "ThesisHealth": {
      "additionalProperties": false,
      "properties": {
        "invalidation_status": {
          "enum": [
            "intact",
            "at_risk",
            "broken"
          ],
          "title": "Invalidation Status",
          "type": "string"
        },
        "permanent_loss_axes": {
          "items": {
            "$ref": "#/$defs/PermanentLossAxis"
          },
          "maxItems": 7,
          "minItems": 7,
          "title": "Permanent Loss Axes",
          "type": "array"
        },
        "evidence_freshness": {
          "$ref": "#/$defs/EvidenceFreshness"
        },
        "current_5y_estimate": {
          "$ref": "#/$defs/Current5yEstimate"
        }
      },
      "required": [
        "invalidation_status",
        "permanent_loss_axes",
        "evidence_freshness",
        "current_5y_estimate"
      ],
      "title": "ThesisHealth",
      "type": "object"
    },
    "ValuationReview": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "resolved",
            "unresolved"
          ],
          "title": "Status",
          "type": "string"
        },
        "current_price_yen": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Price Yen"
        },
        "fair_value_yen": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fair Value Yen"
        },
        "review_trigger": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Trigger"
        }
      },
      "required": [
        "status"
      ],
      "title": "ValuationReview",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "as_of": {
      "format": "date",
      "title": "As Of",
      "type": "string"
    },
    "position_id": {
      "minLength": 1,
      "title": "Position Id",
      "type": "string"
    },
    "ticker": {
      "pattern": "^[0-9A-Z]{4}$",
      "title": "Ticker",
      "type": "string"
    },
    "thesis_health": {
      "$ref": "#/$defs/ThesisHealth"
    },
    "valuation_review": {
      "$ref": "#/$defs/ValuationReview"
    },
    "replacement_comparison": {
      "$ref": "#/$defs/ReplacementComparison"
    },
    "action": {
      "enum": [
        "hold",
        "add",
        "reduce",
        "exit"
      ],
      "title": "Action",
      "type": "string"
    },
    "add_context": {
      "anyOf": [
        {
          "$ref": "#/$defs/AddContext"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reduce_context": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReduceContext"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "note": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Note"
    }
  },
  "required": [
    "schema_version",
    "as_of",
    "position_id",
    "ticker",
    "thesis_health",
    "valuation_review",
    "replacement_comparison",
    "action"
  ],
  "title": "HoldingReviewDocument",
  "type": "object"
}
