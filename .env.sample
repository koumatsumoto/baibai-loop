# このファイルを repository root の .env にコピーし、使う機能の値だけ設定する。
# .env は Git 管理外。以下の変数名は現行コード・ローカル起動 wrapper に合わせる。
# Worker secret の設定雛形は web/edge/.dev.vars.example、設定手順は jobs/OPERATIONS.md を参照。

# データ取得
# J-Quants API v2 key。Screening と経済指標の J-Quants provider が共用する。
# jpx-jquants.com の dashboard で発行し、x-api-key ヘッダで送信する。
JQUANTS_API_KEY=
# EDINET API key。有価証券報告書等の原本取得に使用する。保存原本の再抽出には不要。
EDINET_API_KEY=
# e-Stat application ID。日本 CPI 等の政府統計取得に使用する。
# e-stat.go.jp のマイページ → API機能(アプリケーションID発行)で取得する。
ESTAT_APP_ID=

# ローカルからの R2 store 取得・発行
# baibai-stores の read-write 資格情報。Worker の read-only 資格情報とは分ける。
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ローカルで batch の Discord 通知を送る場合だけ設定する。
# GitHub Actions の通知には、別途 repository secret の設定が必要。
DISCORD_WEBHOOK_URL=

# Baibai の共有 Web 閲覧・API 取得用 token。所有者の VIEW_PASSWORD とは別の値。
# Worker secret の READ_ACCESS_TOKEN と同じ値を設定する。
READ_ACCESS_TOKEN=

# Worker の market lake gateway 設定用（L1/L2の読取。ローカル batch の実行には不要）
# .env への記載だけでは Worker に反映されない。wrangler secret put で個別に設定する。
# 必要なら秘密管理先に別保管し、この3項目は空のままでよい。
# BASE_URL は https://<account-endpoint>/baibai-stores の形式。
# 資格情報は baibai-stores だけに scope した Object Read only。
L1_R2_BASE_URL=
L1_R2_ACCESS_KEY_ID=
L1_R2_SECRET_ACCESS_KEY=
