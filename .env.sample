# このファイルを repository root の .env にコピーし、使う機能の値だけ設定する。
# .env は Git 管理外。全CLIが自動読込するわけではない。
# 認証付きのローカル実行は jobs/OPERATIONS.md の「実行前の確認」に従う。

# データ取得
# J-Quants API v2 key。市場・財務と経済指標の情報取得が共用する。
# jpx-jquants.com の dashboard で発行し、x-api-key ヘッダで送信する。
JQUANTS_API_KEY=
# EDINET API key。有価証券報告書等の原本取得に使用する。保存原本の再抽出には不要。
EDINET_API_KEY=
# e-Stat application ID。日本 CPI 等の政府統計取得に使用する。
# e-stat.go.jp のマイページ → API機能(アプリケーションID発行)で取得する。
ESTAT_APP_ID=

# Alpaca 市場データ。米国株のデータを直接取得する場合だけ設定する。
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# ローカルからの R2 store 読取。発行用の権限は開発環境に持ち込まない。
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ローカルでジョブの Discord 通知を送る場合だけ設定する。
# GitHub Actions の通知には、別途 repository secret の設定が必要。
DISCORD_WEBHOOK_URL=

# Alpaca Paper: 米国株の日足取得でNYSE/Nasdaqの立会日・引け時刻を確認する。発注には使わない。
# 米国株の日足を取得する環境では、上の市場データ用2項目と合わせて設定する。
APCA_PAPER_API_KEY_ID=
APCA_PAPER_API_SECRET_KEY=
