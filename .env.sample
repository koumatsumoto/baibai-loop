# 使う項目だけリポジトリ直下の .env に設定。テスト・CLIの --help には不要。
# 実値はパスワードマネージャーで管理し、Gitに入れない。読み込み方: docs/development.md

# R2（作業用クラウド）: baibai-stores と baibai-serving の両方に Object Read & Write を付けた鍵を使う。
# baibai-stores は正本、baibai-serving はWebの表示データ。認証にはS3用の鍵を使う（Token Valueではない）。
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# 本番Webの閲覧（基本セット）: ログイン画面に入力するパスワード。Worker側の設定は別。
VIEW_PASSWORD=

# GitHub Actions専用: このリポジトリだけの Actions: Read and write。PR作成・pushには使わない。
# gh はこの名前を自動で読まない。起動するコマンドにだけ GH_TOKEN="$GH_ACTIONS_TOKEN" を付ける。
GH_ACTIONS_TOKEN=

# 外部API: ローカルで直接取得するときだけ。R2から取得済みデータを読む場合は不要。
JQUANTS_API_KEY=  # 日本株の市場・財務データと経済指標
EDINET_API_KEY=   # 有価証券報告書などの原本
ESTAT_APP_ID=     # 日本の政府統計（CPIなど）

# Alpaca: 米国株の日足取得用。IEXとSIPの利用権限は別。
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Discord: ローカルから通知を送る場合だけ。Actionsで使う値はリポジトリのSecretsに別途設定。
DISCORD_WEBHOOK_URL=
