JQUANTS_REFRESH_TOKEN=your_jquants_refresh_token
EDINET_API_KEY=your_edinet_api_key
# JPX public regulation sources (CSV/Excel/HTML)
# Prefer the index URL for special caution because the daily margin xls filename changes
# (example: mtdailyk2026042300.xls). The provider resolves the latest xls link from it.
JPX_SPECIAL_CAUTION_INDEX_URL=https://www.jpx.co.jp/markets/statistics-equities/margin/index.html
# Backward-compatible fixed xls URL. Leave empty when JPX_SPECIAL_CAUTION_INDEX_URL is set.
JPX_SPECIAL_CAUTION_URL=
# Supervision/reorganization HTML page. Used to exclude 整理銘柄.
JPX_REORGANIZATION_URL=https://www.jpx.co.jp/listing/market-alerts/supervision/
# Trading halt HTML page. Used to exclude current 取引停止銘柄.
JPX_TRADING_HALT_URL=https://www.jpx.co.jp/markets/equities/suspended/
# Delisted companies HTML page. Used to exclude 上場廃止警告/上場廃止予定銘柄.
JPX_DELISTING_WARNING_URL=https://www.jpx.co.jp/listing/stocks/delisted/
